# Docker 部署配置示例
# 复制为 server/.env.docker 后修改；该文件不要提交到 Git。
#
# HOST / PORT / SERVE_STATIC / DATABASE_FILE 由 docker-compose.yml 固定设置，
# 这里只需要配置公开地址、Cookie、初始化和日志。

# 控制台公开地址，必须和浏览器地址完全一致（协议 + 域名，可带端口，结尾不要 /）
PUBLIC_ORIGIN=https://ink.example.com

# 允许的跨域来源；同源部署时与 PUBLIC_ORIGIN 保持一致即可
CORS_ORIGIN=https://ink.example.com

# HTTPS 部署必须为 true；如果暂时用 HTTP 测试，先改成 false
COOKIE_SECURE=true

# 位于 OpenResty 反向代理之后
TRUST_PROXY=true

# 公网部署必须要求初始化码，避免别人抢先创建管理员
SETUP_REQUIRE_CODE=true
# INKPANE_SETUP_CODE=换成随机字符串

# 可选：直接引导第一个管理员，设置后无需访问 /setup
# INKPANE_ADMIN_USERNAME=admin
# INKPANE_ADMIN_PASSWORD=换成强密码

# 首次创建管理员时是否写入演示数据
SEED_ON_EMPTY=false

LOG_LEVEL=info
