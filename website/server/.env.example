# InkPane 日程服务环境变量示例
# 复制为 .env 后按需修改

# HTTP 服务监听端口
PORT=4000

# 监听地址。127.0.0.1 仅本机可访问；0.0.0.0 允许局域网设备与控制台访问。
# 启用多用户后，管理接口已要求登录；仍建议只在可信局域网使用，跨网访问请加 HTTPS 反代。
HOST=127.0.0.1

# 运行环境：development | production | test
NODE_ENV=development

# SQLite 数据库文件路径（相对于 server/ 目录，或使用绝对路径）
DATABASE_FILE=../data/inkpane.sqlite

# 允许跨域的前端来源，多个用英文逗号分隔；不能使用 *
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 生产同源部署时的公开地址（用于 CSRF Origin 校验，可留空）
# PUBLIC_ORIGIN=https://inkpane.example.com

# 控制台会话有效期（天）
SESSION_TTL_DAYS=30

# 通过 HTTPS 反代访问时设为 true，Cookie 只走加密连接
COOKIE_SECURE=false

# 是否位于反向代理之后；开启后使用 X-Forwarded-For 作为客户端 IP
TRUST_PROXY=false

# 请求体大小上限
BODY_LIMIT=256kb

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 是否托管 web/dist 静态资源（前后端同进程部署时设为 true）
SERVE_STATIC=false

# 首次启动且数据库为空时，是否写入演示数据（在初始化管理员时执行）
SEED_ON_EMPTY=true

# 可选：通过环境变量引导第一个管理员；不设置则打开控制台走 /setup
# INKPANE_ADMIN_USERNAME=admin
# INKPANE_ADMIN_PASSWORD=change-me-please

# 课程同步默认拒绝私网/回环地址；校园内网场景才显式开启
COURSE_ALLOW_PRIVATE_HOSTS=false
