# InkPane firmware defaults (ESP-IDF v6.x, target esp32s3).
CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash, PSRAM used for the 48 KB framebuffer and HTTP bodies.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Custom partition table (font blob pushes the app over 1 MB).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Logging / runtime.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Wi-Fi: modest buffers, power save is disabled in code while awake.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y

# The device only talks plain HTTP to the local service.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n

# InkPane defaults (see main/Kconfig.projbuild).
CONFIG_INKPANE_API_URL="http://192.168.1.10:4000"
CONFIG_INKPANE_DEVICE_TOKEN=""
CONFIG_INKPANE_AP_PREFIX="InkPane"
CONFIG_INKPANE_FULL_REFRESH_INTERVAL=60
CONFIG_INKPANE_TELEMETRY=y
