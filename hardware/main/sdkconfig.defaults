# InkPane firmware defaults (ESP-IDF v6.x, target esp32s3).
CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash, PSRAM used for the 48 KB framebuffer and HTTP bodies.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Custom partition table (font blob pushes the app over 1 MB).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Logging / runtime.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# SNTP: the device needs a valid clock before TLS/WSS, so allow more than lwIP's
# single default server (one DNS miss would otherwise mean a failed sync) and
# disable the random 0..5 s startup delay that eats the boot-time sync budget.
CONFIG_LWIP_SNTP_MAX_SERVERS=3
# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set

# Wi-Fi: modest buffers, power save is disabled in code while awake.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y

# The dashboard API stays plain HTTP on the LAN, but the voice assistant talks
# HTTPS/WSS to the xiaozhi OTA/WebSocket service, so TLS must be compiled in.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Resident voice assistant: Wi-Fi + AFE/MultiNet + Opus need internal RAM, so
# reserve a chunk for internal allocations and keep TLS buffers in PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# IDF rejects RX_BA_WIN > DYNAMIC_RX_BUFFER_NUM; 6 keeps aggregation without
# the internal-RAM cost of a larger RX pool.
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP32_WIFI_RX_BA_WIN=6
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# The vendored xiaozhi audio/protocol code does not throw or use RTTI.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# InkPane defaults (see main/Kconfig.projbuild).
CONFIG_INKPANE_API_URL="http://192.168.1.10:4000"
CONFIG_INKPANE_DEVICE_TOKEN=""
CONFIG_INKPANE_AP_PREFIX="InkPane"
CONFIG_INKPANE_FULL_REFRESH_INTERVAL=60
CONFIG_INKPANE_TELEMETRY=y

# ESP-SR models: read from the `model` partition, custom wake words via
# MultiNet7 Chinese, VADNet for server-side turn detection. WakeNet / NSNet /
# TTS are intentionally not selected (flash + RAM budget, MultiNet covers the
# wake phrase).
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_NSN_WEBRTC=y

# Voice assistant defaults (see main/Kconfig.projbuild).
CONFIG_INKPANE_POWER_MODE_RESIDENT=y
CONFIG_INKPANE_VOICE=y
CONFIG_INKPANE_VOICE_OTA_URL="https://api.tenclass.net/xiaozhi/ota/"
# Wake words are MultiNet runtime commands: pinyin syllables, no tones, no Han
# characters ("da fen qi" = 达芬奇). Chinese input is rejected by MultiNet.
CONFIG_INKPANE_VOICE_WAKE_WORDS="da fen qi"
CONFIG_INKPANE_VOICE_WAKE_THRESHOLD=65
CONFIG_INKPANE_VOICE_VOLUME=60
CONFIG_INKPANE_VOICE_ALLOW_CONTROL=y
# Barge-in: the codec feeds a virtual playback reference channel to the AFE AEC
# so speech during a reply can stop it without the speaker self-triggering.
CONFIG_INKPANE_VOICE_BARGE_IN=y
# CONFIG_INKPANE_VOICE_WAKE_DURING_PLAYBACK is not set
